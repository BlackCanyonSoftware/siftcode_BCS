{
  "name": "siftcode",
  "version": "0.0.0",
  "private": true,
  "description": "Offline code and architecture analysis that finds where a project departs from proven standards and suggests how to improve it.",
  "license": "Apache-2.0",
  "author": "Black Canyon Software",
  "homepage": "https://github.com/BlackCanyonSoftware/siftcode_BCS#readme",
  "bugs": {
    "url": "https://github.com/BlackCanyonSoftware/siftcode_BCS/issues"
  },
  "keywords": [
    "static-analysis",
    "code-quality",
    "architecture",
    "software-design",
    "metrics",
    "sarif",
    "cwe",
    "offline",
    "typescript",
    "python",
    "csharp"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BlackCanyonSoftware/siftcode_BCS.git"
  },
  "type": "module",
  "bin": {
    "siftcode": "dist/cli/main.js"
  },
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "!dist/**/*.map",
    "grammars",
    "data",
    "assets/report",
    "assets/brand/theme/theme.css",
    "assets/brand/template/tokens.css",
    "assets/brand/template/fonts.css",
    "assets/brand/template/base.css",
    "assets/brand/template/components.css",
    "assets/brand/template/layout.css",
    "assets/brand/template/footer.html",
    "assets/brand/font",
    "assets/brand/ui/icons.svg",
    "assets/brand/mark/mark.svg",
    "assets/brand/wordmark/wordmark-light.svg",
    "assets/brand/wordmark/wordmark-dark.svg",
    "assets/brand/web/icon.svg",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "build:grammars": "node scripts/copy-grammars.mjs",
    "build:licenses": "node scripts/build-licenses.mjs",
    "review:license-table": "node scripts/license-table-review.mjs",
    "build": "npm run build:grammars && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "fetch:sarif-schema": "node scripts/fetch-sarif-schema.mjs",
    "sbom": "node scripts/make-sbom.mjs",
    "test": "npm run build:grammars && npm run fetch:sarif-schema && vitest run test/unit",
    "benchmark": "npm run build && node scripts/benchmark.mjs",
    "test:e2e": "npm run build && vitest run test/e2e",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "hooks:install": "git config core.hooksPath .githooks",
    "release:check": "npm run build && node scripts/verify-package.mjs"
  },
  "dependencies": {
    "ignore": "7.0.14",
    "web-tree-sitter": "0.27.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "ajv": "8.20.0",
    "ajv-draft-04": "1.0.0",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "spdx-license-list": "6.12.0",
    "tree-sitter-c-sharp": "0.23.5",
    "tree-sitter-javascript": "0.25.0",
    "tree-sitter-python": "0.25.0",
    "tree-sitter-typescript": "0.23.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "5.0.5"
  }
}
